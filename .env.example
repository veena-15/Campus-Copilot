# OpenAI-compatible Navigate Labs API. Set the full chat completions URL, API key,
# and model name supplied by your Navigate Labs account. Keys stay server-side.
NAVIGATE_API_URL=
NAVIGATE_API_KEY=
NAVIGATE_MODEL=

# Optional alternative provider, used only when Navigate Labs is not configured.
# Keep this key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase project credentials. The publishable/anon key is safe for browser use
# only because queries are protected with Auth and RLS; never use a service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI backend URL used by the browser. Local Uvicorn default:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
